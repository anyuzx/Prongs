---
title: Page Not Found!
permalink: 404.html
layout: layouts/empty.njk
codeHighlighting: true
script:
  - src: https://cdn.jsdelivr.net/npm/ngl@2.5.0/dist/ngl.js
    link: true
    head: true
    defer: true
  - src: js/initNGL.js
    inline: true
---

<main class="b-text">
<section class="flow mt-10">
  <h1 class="text-center">{{ title }}</h1>
  <p class="text-center">Return to <a href="/">Homepage</a></p>
</section>
<section class="max-w-screen-md mx-auto p-2" aria-label="PDB structure 6CO8">
  <div class="border-2 border-darkergray" style="height:50vh;position:relative;background:white;">
    <img id="NGLfallback" src="/assets/images/404/6co8-assembly-1.jpeg" width="500" height="500" alt="Static view of PDB structure 6CO8, biological assembly 1" style="position:absolute;width:100%;height:100%;object-fit:contain;margin:0;">
    <div id="NGLviewport" aria-label="Interactive 3D view of PDB structure 6CO8" style="position:relative;width:100%;height:100%;visibility:hidden;"></div>
  </div>
  <p id="NGLstatus" role="status" class="text-xs text-gray-500">Interactive viewing requires JavaScript and WebGL.</p>
  <p class="text-xs text-gray-500 text-right font-mono"><a href="https://www.rcsb.org/structure/6CO8">PDB 6CO8</a> · Powered by <a href="https://github.com/nglviewer/ngl" rel="noreferrer">NGL</a></p>
  <p id="NGLimageCredit" class="text-xs text-gray-500">Structure image: RCSB PDB, <a href="https://doi.org/10.1016/j.str.2018.05.006">Sevvana et al. (2018)</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</p>
  <div>
    {% set snippet -%}
// Run after the viewer container and NGL are ready.
var stage = new NGL.Stage("NGLviewport", { backgroundColor: "white" });
stage.loadFile("https://files.rcsb.org/download/6CO8.cif", {
    defaultAssembly: "BU1"
}).then(function (component) {
    component.addRepresentation("cartoon", { sele: "polymer" });
    stage.autoView();
});
    {%- endset -%}
    
    {% codeHighlight "js" %}
    {{- snippet | safe -}}
    {% endcodeHighlight %}
  </div>
</section>
</main>
