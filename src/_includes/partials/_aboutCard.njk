<section class="profile-card">
  <figure class="profile-portrait">
    <img src="{{ site.AUTHOR.PHOTO }}" alt="{{ site.AUTHOR.NAME }}" class="profile-photo">
  </figure>
  <div class="profile-details">
    <h1>{{ site.AUTHOR.NAME }}</h1>
    <p class="profile-role">{{ site.AUTHOR.TITLE }}</p>
    <p class="profile-bio">{{ site.AUTHOR.SHORT_BIO }}</p>
    <div class="profile-links">
      {% if site.AUTHOR.GOOGLE_SCHOLAR %}
        <a href="{{ site.AUTHOR.GOOGLE_SCHOLAR }}" rel="noopener noreferrer" target="_blank">Google Scholar <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if site.AUTHOR.GITHUB %}
        <a href="https://github.com/{{ site.AUTHOR.GITHUB }}" rel="noopener noreferrer" target="_blank">GitHub <span aria-hidden="true">↗</span></a>
      {% endif %}
    </div>
  </div>
</section>
