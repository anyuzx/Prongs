<section class="academic-profile" aria-label="Academic profile">
  <div class="academic-profile__details">
    <h1 class="academic-profile__name">{{ site.AUTHOR.NAME }}</h1>
    <p class="academic-profile__role">{{ site.AUTHOR.TITLE }}</p>
    <p class="academic-profile__affiliation">{{ site.AUTHOR.DEPARTMENT }}<br>{{ site.AUTHOR.UNIVERSITY }}</p>
    <div class="academic-profile__links" aria-label="Professional links">
      <a href="mailto:{{ site.AUTHOR.EMAIL }}">Email</a>
      <a href="{{ site.AUTHOR.GOOGLE_SCHOLAR }}" target="_blank" rel="noopener noreferrer">Google Scholar</a>
      <a href="https://github.com/{{ site.AUTHOR.GITHUB }}" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
  <figure class="academic-profile__portrait">
    <img src="{{ site.AUTHOR.PHOTO }}" alt="Portrait of {{ site.AUTHOR.NAME }}">
  </figure>
</section>
