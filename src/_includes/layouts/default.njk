{% extends "layouts/base.njk" %}

{% block head %}
{{ super() }}
{% endblock %}

{% block bodyopen %}
  <body class="site-body antialiased min-h-screen flex flex-col">
{% endblock %}

{% block body %}

<a class="skip-link" href="#main-content">Skip to content</a>

{# disable navigation bar if disableNavigation is set to false in the front matter #}
{% ifAsync not disableNavigation %}
  {% include "partials/_nav.njk" %}
{% endif %}

{# layout has default and wide mode. Wide mode has width equal to the screen #}
{% if full %}
  <main id="main-content" tabindex="-1" class="site-main site-shell-full">
{% elif wide %}
  <main id="main-content" tabindex="-1" class="site-main site-shell-wide">
{% else %}
  <main id="main-content" tabindex="-1" class="site-main">
{% endif %}

{% block content %}
  {{ content | safe }}
{% endblock %}
</main>

{# disbale footer if disableFooter is set to false in the front matter #}
{% ifAsync not disableFooter %}
  {% include "partials/_footer.njk" %}
{% endif %}

{% endblock %}

{% block bodyclose %}
{{ super() }}
{% endblock %}
