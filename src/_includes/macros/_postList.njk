{% macro list(collection) %}
{% for post in collection -%}
  <article class="post-item" id="post-{{ loop.index }}">
    <div class="post-info">
      <a href="{{ post.url }}" class="post-link no-underline">
        {{ post.data.title }}
      </a>
      <div class="post-meta">
        <time datetime="{% dayjs post.date, 'YYYY-MM-DD' %}">
          {% dayjs post.date, 'YYYY-MM-DD' %}
        </time>
        <button type="button" class="plus-minus post-toggle" id="post-toggle-{{ loop.index }}" aria-label="Hide excerpt: {{ post.data.title | escape }}" aria-expanded="true" aria-controls="post-excerpt-{{ loop.index }}" data-excerpt-toggle data-post-title="{{ post.data.title | escape }}" hidden>
        </button>
      </div>
    </div>
    <div id="post-excerpt-{{ loop.index }}" class="post-excerpt">
      {# use excerpt filter #}
      {{ post | excerpt | safe }}
    </div>
  </article>
{%- endfor %}
{% endmacro %}


{% macro cards(collection) %}
<div>
  {% for post in collection -%}
    <a class="post-card" href="{{ post.url }}">
      <div class="post-title">
        {{ post.data.title }}
      </div>
      <div class="post-excerpt">
        {{ post.data.excerpt | renderUsingMarkdown | safe }}
      </div>
    </a>
  {%- endfor %}
</div>
{% endmacro %}
