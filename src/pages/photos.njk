---
layout: layouts/default.njk
wide: true
permalink: /photos/index.html
title: Photos
description: A collection of Guang Shi's photos
script:
    - src: js/lazyLoading.js
      inline: true
      head: true
    - src: https://cdn.jsdelivr.net/npm/vanilla-lazyload@15.1.1/dist/lazyload.min.js
      link: true
      async: true
      head: true
---

{% set archiveLogo %}
  {% include "svg/archive.svg" %}
{% endset %}

{% set cloudinary_url = "https://res.cloudinary.com/" + site.CLOUDINARY + "/image/upload" %}

<header class="page-heading gallery-heading">
  <h1>Photos</h1>
  <a href="/photos/archive/" class="gallery-archive">View archive <span aria-hidden="true">→</span></a>
</header>
{% for photo in collections.photos | reverse -%}
    {% set photoSlug = photo.public_id.split("/")[1] | slug %}
    <figure class="gallery-entry">
    {% if loop.index < 4 %}
    <a href="/photos/{{ photoSlug }}/" class="block overflow-hidden">
        {% responImg photo.public_id, photo.context.custom.caption, "(max-width:650px) 100vw, (max-width:1980px) 800px, 1280px", 2400, [800,1600,2400], ['gallery-image'], 'guangshi' %}
    </a>
    {% else %}
    <a href="/photos/{{ photoSlug }}/" class="block overflow-hidden">
        {% responImg photo.public_id, photo.context.custom.caption, "(max-width:650px) 100vw, (max-width:1980px) 800px, 1280px", 2400, [800,1600,2400], ['gallery-image','lazy'], 'guangshi' %}
    </a>
    {% endif %}
    {% if photo.context.custom.caption %}
      <figcaption class="gallery-caption">{{ photo.context.custom.caption }}</figcaption>
    {% endif %}
    </figure>
{%- endfor %}
