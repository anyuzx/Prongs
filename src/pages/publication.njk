---
layout: layouts/default.njk
permalink: /publication/index.html
title: Publications
description: Publications, talks, and posters by Guang Shi
script:
  - src: js/tabs.js
    inline: true
---

<header class="page-heading">
  <h1>Publications</h1>
  <p class="page-description"><a href="{{ site.AUTHOR.GOOGLE_SCHOLAR }}">Google Scholar <span aria-hidden="true">↗</span></a></p>
</header>

<div class="publication-tabs">
  <nav class="nav-tab" aria-label="Publication sections">
    <div class="publication-tab-list">
      <a class="publication-tab" id="publications-tab" href="#publications">Publications</a>
      <a class="publication-tab" id="talks-tab" href="#talks">Talks &amp; Posters</a>
    </div>
  </nav>

  <section class="tab-pane" id="publications" aria-labelledby="publications-heading">
    <h2 class="publication-panel-heading" id="publications-heading">Publications</h2>
    {% for year, publications in getPublications | groupByEx("issued.date-parts.0.0") %}
    <h3 class="publication-year">{{ year }}</h3>
    <ol class="publication-list list-none ml-0">
      {% for publication in publications %}
      <li class="publication-item">
        <div class="publication-title-row">
          {% if publication.DOI %}
          <a class="publication-title" href="https://doi.org/{{ publication.DOI }}">{{ publication.title }} <span aria-hidden="true">↗</span></a>
          {% else %}
          <span class="publication-title">{{ publication.title }}</span>
          {% endif %}
          {% if publication.subtype === "preprint" %}
          <span class="publication-badge">preprint</span>
          {% endif %}
        </div>
        <div class="publication-meta">
          {% for author in publication.author %}
            <span{% if author.family == "Shi" and author.given == "Guang" %} class="publication-author"{% endif %}>{{ author.family }}{% if author.given %}, {{ author.given }}{% endif %}{% if not loop.last %}; {% endif %}</span>
          {% endfor %}
          <span class="italic">{{ publication["container-title"] }}</span><span> ({{ publication["issued"]["date-parts"][0][0] }})</span>
        </div>
      </li>
      {% endfor %}
    </ol>
    {%- endfor %}
  </section>

  <section class="tab-pane" id="talks" aria-labelledby="talks-heading">
    <h2 class="publication-panel-heading" id="talks-heading">Talks &amp; Posters</h2>
    <ol class="talk-list list-none ml-0">
      {% for item in getTalksPosters | sort(true, false, "date") %}
      <li class="talk-item">
        <div class="publication-title-row">
          <span class="publication-badge">{{ item.type }}</span>
          <span class="publication-title">{{ item.title }}</span>
        </div>
        <div class="publication-meta">
          <span>{{ item.info | inlineRenderUsingMarkdown | safe }}. {% dayjs item.date, 'MMM, YYYY' %}.</span>
          {% if item.link %}<a href="{{ item.link.url }}">{{ item.link.title }}</a>{% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </section>
</div>
